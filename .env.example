# Copy to .env and fill in what you need.

# Which LLM the app uses by default: anthropic | openai
LLM_PROVIDER=anthropic

# At least one LLM key is required for summaries and Q&A (from M3).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (sensible cheap defaults are used if blank).
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Optional: raises Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=
