# Copy to .env and fill in what you need.

# Which LLM the app uses by default: anthropic | openai | ollama. The header
# dropdown lists every provider that can answer and can switch between them.
LLM_PROVIDER=anthropic

# Summaries, Q&A and the LLM metadata pass need an LLM: either one of these
# keys, or a local Ollama (below), which needs no key. Keys can also be pasted
# into the app (API keys, in the header), which saves them here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: a local Ollama server. The app finds it at this URL whenever it is
# running and has OLLAMA_MODEL pulled (`ollama pull gemma3:4b`), with no
# restart needed. Leave OLLAMA_URL blank to stop the app from looking for it.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# Seconds before a local request gives up; CPU-only machines are slow.
# OLLAMA_TIMEOUT=900
# Context window in tokens. Summaries send up to about 8k tokens of paper text.
# OLLAMA_NUM_CTX=16384

# Optional model overrides. Blank uses the cheap, fast defaults:
# claude-haiku-5-5 and gpt-5.4-mini.
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Optional: seconds before an LLM request gives up.
# LLM_TIMEOUT=90

# Optional: raises Semantic Scholar rate limits. Without one, searches fall
# back to arXiv whenever Semantic Scholar answers "too many requests".
SEMANTIC_SCHOLAR_API_KEY=

# Optional: where the database, PDFs and embedding model are stored
# (default: data/ in the repo).
# DATA_DIR=

# Optional: the backend URL the frontend dev server proxies /api to. Change it
# only if you run the backend on a port other than 8000.
# BACKEND_URL=http://localhost:8000
